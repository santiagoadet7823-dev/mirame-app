<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: equivalente de allowBackup=false / fullBackupContent=false,
     que en esas versiones se ignoran. Ni backup a la nube ni transferencia
     entre dispositivos: ver el comentario en AndroidManifest.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
